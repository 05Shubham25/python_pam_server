# Normalize line endings to LF in the repository for everyone
* text=auto eol=lf

# Explicitly LF for source files
*.py    text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.mjs   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.env   text eol=lf
*.txt   text eol=lf
*.ini   text eol=lf
*.toml  text eol=lf

# Binary files — no line-ending conversion
*.png   binary
*.jpg   binary
*.jpeg  binary
*.ico   binary
*.zip   binary
*.gz    binary
*.woff  binary
*.woff2 binary
